#!/usr/bin/env python3
"""Quality evals: run the same tasks with and without the workflow, several times,
and report how much the results vary, not only the averages.

Usage: run-quality-evals [--task ID ...] [--runs N] [--jobs N] [--model MODEL]

Each run is a real Claude Code session in a throwaway copy of evals/fixture,
in dontAsk mode with an allowlist. The "without" arm adds
`--setting-sources project --disable-slash-commands` (docs/adr/0001). After a
session its changes are collected, red flags are set, and hidden tests the
agent can't read are run. Run i of both arms of a task is then judged by a
blind, order-swapped judge (docs/adr/0002). Everything is saved under
~/.cache/agent-workflow/quality-evals/<timestamp>/.

A full run is 30 sessions on your subscription, so this is not part of
run-checks.
"""

from __future__ import annotations

import argparse
import dataclasses
import json
import re
import shutil
import subprocess
import sys
import tempfile
import time
import traceback
from collections.abc import Iterable
from concurrent.futures import Future, ThreadPoolExecutor, as_completed
from dataclasses import asdict, dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from aw import quality  # noqa: E402
from aw.sessions import claude_bin, fixture_copy, run_session  # noqa: E402
from aw.state import state_dir  # noqa: E402
from aw.test_edits import compare  # noqa: E402

QUALITY = ROOT / "evals" / "quality"
FIXTURE = ROOT / "evals" / "fixture"
# Everyday development commands, the same for both arms. Not a sandbox: running the tests
# already executes code the agent wrote. It keeps out the destructive and outward-facing
# commands (rm, pip, curl, git push and the like).
ALLOWLIST = (
    "Skill", "Agent", "Read", "Glob", "Grep", "Edit", "Write",
    "Bash(python3 *)", "Bash(cd *)", "Bash(ls*)", "Bash(find *)", "Bash(cat *)", "Bash(mkdir *)",
    "Bash(which *)", "Bash(git status*)", "Bash(git diff*)",
    "Bash(~/agent-workflow/bin/run-checks*)", f"Bash({ROOT}/bin/run-checks*)",
)
# The hidden tests live here; with normal user settings a session could otherwise read them.
DENYLIST = ("Read(~/agent-workflow/evals/**)", "Grep(~/agent-workflow/evals/**)", "Glob(~/agent-workflow/evals/**)")
WITHOUT_WORKFLOW = ("--setting-sources", "project", "--disable-slash-commands")
JUDGED_PATHS = ("billing", "tests")
HIDDEN_TIMEOUT_S = 120
JUDGE_TIMEOUT_S = 600
JUDGE_BUDGET_USD = 1.0
_HIDDEN_RUNNER = (
    "import json, os, unittest\n"
    "suite = unittest.defaultTestLoader.discover('tests', pattern='test_hidden_*.py', top_level_dir='.')\n"
    "result = unittest.TextTestRunner(stream=open(os.devnull, 'w')).run(suite)\n"
    "print(json.dumps({'ran': result.testsRun, 'failed': len(result.failures) + len(result.errors)}))\n"
)


@dataclass(frozen=True)
class Settings:
    model: str
    budget_usd: float
    timeout_minutes: float


@dataclass(frozen=True)
class SessionResult:
    """What one session left behind, before the judge."""

    score: quality.RunScore
    judged_diff: str


def _session_command(task: quality.Task, arm: str, settings: Settings) -> list[str]:
    command = [
        claude_bin(), "-p", task.prompt,
        "--model", settings.model,
        "--permission-mode", "dontAsk",
        "--allowedTools", ",".join(ALLOWLIST),
        "--disallowedTools", ",".join(DENYLIST),
        "--max-budget-usd", str(settings.budget_usd),
        "--no-session-persistence",
        "--output-format", "stream-json", "--verbose",
    ]
    return command + (list(WITHOUT_WORKFLOW) if arm == "without" else [])


def _record(lines: Iterable[str], transcript: Path) -> dict[str, object]:
    """Save every line and return the final result event (empty if there was none)."""
    final: dict[str, object] = {}
    with transcript.open("w") as out:
        for line in lines:
            out.write(line)
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(event, dict) and event.get("type") == "result":
                final = event
    return final


def _git(repo: Path, *args: str) -> str:
    return subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, check=True).stdout


def _hidden_tests(task: quality.Task) -> list[Path]:
    return sorted((QUALITY / "hidden" / task.id).glob("test_hidden_*.py"))


def _hidden_total(task: quality.Task) -> int:
    """Counted from the files, so a run whose code can't even be imported still scores 0 of total."""
    return sum(len(re.findall(r"^\s+def test_", f.read_text(), re.M)) for f in _hidden_tests(task))


def _run_hidden_tests(repo: Path, task: quality.Task) -> tuple[int, str]:
    """(passed, output) for the hidden tests, copied in only now, after the session."""
    total = _hidden_total(task)
    try:
        (repo / "tests").mkdir(exist_ok=True)
        for path in _hidden_tests(task):
            shutil.copy(path, repo / "tests" / path.name)
        done = subprocess.run(
            [sys.executable, "-c", _HIDDEN_RUNNER], cwd=repo, capture_output=True, text=True,
            timeout=HIDDEN_TIMEOUT_S, check=False,
        )
        counts = json.loads(done.stdout.strip().splitlines()[-1])
        passed = max(0, int(counts["ran"]) - int(counts["failed"]))
        return min(passed, total), done.stdout + done.stderr
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, IndexError, KeyError, ValueError) as error:
        return 0, f"hidden tests could not run: {error!r}"


def _weakened_tests(repo: Path, changed: list[str]) -> bool:
    """Whether any test file under tests/ that existed before lost assertions or gained skips."""
    for path in changed:
        if not path.startswith("tests/"):
            continue
        try:
            before = _git(repo, "show", f"HEAD:{path}")
        except subprocess.CalledProcessError:
            continue  # a new test file can't be weakened
        after = (repo / path).read_text() if (repo / path).is_file() else ""
        if compare(before, after).weakens:
            return True
    return False


def run_once(task: quality.Task, arm: str, index: int, settings: Settings, out: Path) -> SessionResult:
    run_dir = out / task.id / f"{arm}-{index}"
    run_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=f"aw-quality-{task.id}-{arm}-") as tmp:
        repo = fixture_copy(FIXTURE, Path(tmp))
        end = run_session(
            _session_command(task, arm, settings), repo, settings.timeout_minutes * 60,
            lambda lines: _record(lines, run_dir / "transcript.jsonl"), stderr_path=run_dir / "stderr.txt",
        )
        final = end.value
        _git(repo, "add", "-A")
        changed = [p for p in _git(repo, "diff", "--cached", "--no-renames", "--name-only", "HEAD").splitlines() if p]
        (run_dir / "diff.patch").write_text(_git(repo, "diff", "--cached", "--no-renames", "HEAD"))
        judged_diff = _git(repo, "diff", "--cached", "--no-renames", "HEAD", "--", *JUDGED_PATHS)
        weakened = _weakened_tests(repo, changed)
        incomplete = end.timed_out or final.get("subtype") != "success"
        passed, output = _run_hidden_tests(repo, task)
    (run_dir / "hidden-tests.txt").write_text(output)
    cost = final.get("total_cost_usd")
    score = quality.RunScore(
        task=task.id, arm=arm, index=index, tests_passed=passed, tests_total=_hidden_total(task),
        flags=quality.red_flags(changed, task.allowed, weakened=weakened, incomplete=incomplete),
        judge=None, judge_error=False, minutes=round(end.seconds / 60, 2),
        cost_usd=float(cost) if isinstance(cost, (int, float)) else None,
        refused=len(denials) if isinstance(denials := final.get("permission_denials"), list) else 0,
    )
    (run_dir / "score.json").write_text(json.dumps(asdict(score), indent=2))
    return SessionResult(score, judged_diff)


def run_once_safely(task: quality.Task, arm: str, index: int, settings: Settings, out: Path) -> SessionResult:
    """A run that failed in the harness is recorded as incomplete instead of losing the whole eval."""
    try:
        return run_once(task, arm, index, settings, out)
    except Exception:
        run_dir = out / task.id / f"{arm}-{index}"
        run_dir.mkdir(parents=True, exist_ok=True)
        (run_dir / "harness-error.txt").write_text(traceback.format_exc())
        score = quality.RunScore(
            task=task.id, arm=arm, index=index, tests_passed=0, tests_total=_hidden_total(task),
            flags=("incomplete",), judge=None, judge_error=False, minutes=0.0, cost_usd=None,
        )
        return SessionResult(score, "")


def _judge_once(prompt: str, settings: Settings, reply_file: Path) -> quality.JudgeVerdict | None:
    """One judge call, retried once on invalid output. The judge runs in an empty folder,
    with no tools and none of the workflow."""
    command = [
        claude_bin(), "-p", prompt, "--model", settings.model, "--tools", "",
        *WITHOUT_WORKFLOW, "--permission-mode", "dontAsk", "--max-budget-usd", str(JUDGE_BUDGET_USD),
        "--no-session-persistence", "--output-format", "json",
    ]
    replies: list[str] = []
    verdict: quality.JudgeVerdict | None = None
    with tempfile.TemporaryDirectory(prefix="aw-judge-") as empty:
        for _attempt in range(2):
            try:
                done = subprocess.run(command, cwd=empty, capture_output=True, text=True, timeout=JUDGE_TIMEOUT_S, check=False)
            except (OSError, subprocess.TimeoutExpired) as error:
                replies.append(f"judge call failed: {error!r}")
                continue
            try:
                envelope = json.loads(done.stdout)
                text = str(envelope.get("result", "")) if isinstance(envelope, dict) else done.stdout
            except json.JSONDecodeError:
                text = done.stdout
            replies.append(text)
            verdict = quality.parse_judge(text)
            if verdict is not None:
                break
    reply_file.write_text("\n\n--- retry ---\n\n".join(replies))
    return verdict


def judge_pair(task: quality.Task, index: int, with_run: SessionResult, without_run: SessionResult,
               settings: Settings, out: Path) -> tuple[quality.RunScore, quality.RunScore]:
    judge_dir = out / "judge"
    judge_dir.mkdir(parents=True, exist_ok=True)
    spec = (FIXTURE / task.spec).read_text() if task.spec else None
    with ThreadPoolExecutor(max_workers=2) as orders:  # both orders at the same time
        order1 = orders.submit(
            _judge_once, quality.judge_prompt(task.prompt, spec, with_run.judged_diff, without_run.judged_diff),
            settings, judge_dir / f"{task.id}-{index}-order1.txt",
        )
        order2 = orders.submit(
            _judge_once, quality.judge_prompt(task.prompt, spec, without_run.judged_diff, with_run.judged_diff),
            settings, judge_dir / f"{task.id}-{index}-order2.txt",
        )
        with_first, without_first = order1.result(), order2.result()
    if with_first is None or without_first is None:
        return (
            dataclasses.replace(with_run.score, judge=None, judge_error=True),
            dataclasses.replace(without_run.score, judge=None, judge_error=True),
        )
    with_scores, without_scores = quality.resolve_judge(with_first, without_first)
    return (
        dataclasses.replace(with_run.score, judge=with_scores),
        dataclasses.replace(without_run.score, judge=without_scores),
    )


def judge_pair_safely(task: quality.Task, index: int, with_run: SessionResult, without_run: SessionResult,
                      settings: Settings, out: Path) -> tuple[quality.RunScore, quality.RunScore]:
    try:
        return judge_pair(task, index, with_run, without_run, settings, out)
    except Exception:
        (out / "judge").mkdir(parents=True, exist_ok=True)
        (out / "judge" / f"{task.id}-{index}-harness-error.txt").write_text(traceback.format_exc())
        return (
            dataclasses.replace(with_run.score, judge=None, judge_error=True),
            dataclasses.replace(without_run.score, judge=None, judge_error=True),
        )


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--task", action="append", default=[], help="run only this task (repeatable)")
    parser.add_argument("--runs", type=int, default=5, help="runs per task per arm")
    parser.add_argument("--jobs", type=int, default=4, help="sessions in parallel")
    parser.add_argument("--model", default="sonnet", help="model for the sessions and the judge")
    args = parser.parse_args(argv[1:])

    tasks = quality.load_tasks(QUALITY / "tasks.json")
    if args.task:
        unknown = set(args.task) - {t.id for t in tasks}
        if unknown:
            print(f"run-quality-evals: unknown task(s): {', '.join(sorted(unknown))}", file=sys.stderr)
            return 2
        tasks = [t for t in tasks if t.id in args.task]
    problems = [f"task {t.id}: spec {t.spec} not found in the fixture" for t in tasks if t.spec and not (FIXTURE / t.spec).is_file()]
    problems += [f"task {t.id}: no hidden tests" for t in tasks if not _hidden_tests(t)]
    if shutil.which(claude_bin()) is None:
        problems.append(f"`{claude_bin()}` not found")
    if problems:
        print("run-quality-evals: " + "; ".join(problems), file=sys.stderr)
        return 2
    settings = Settings(model=args.model, budget_usd=3.0, timeout_minutes=20)
    # The "with" sessions take longest, so they start first and don't end up as the run's tail.
    planned = [(task, arm, i) for arm in quality.ARMS for task in tasks for i in range(1, args.runs + 1)]
    print(
        f"Running {len(planned)} sessions ({len(tasks)} task(s) x {args.runs} runs x 2 arms) on {args.model}; "
        f"each capped at ${settings.budget_usd:.0f} and timeout {settings.timeout_minutes:g} min.",
        flush=True,
    )

    out = state_dir() / "quality-evals" / time.strftime("%Y%m%d-%H%M%S")
    out.mkdir(parents=True, exist_ok=True)
    by_id = {t.id: t for t in tasks}
    sessions: dict[tuple[str, str, int], SessionResult] = {}
    judged: list[Future[tuple[quality.RunScore, quality.RunScore]]] = []
    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool, \
            ThreadPoolExecutor(max_workers=max(1, args.jobs)) as judges:
        futures = {pool.submit(run_once_safely, t, arm, i, settings, out): (t.id, arm, i) for t, arm, i in planned}
        for future in as_completed(futures):
            task_id, arm, i = futures[future]
            sessions[(task_id, arm, i)] = future.result()
            other = (task_id, "without" if arm == "with" else "with", i)
            if other in sessions:  # both runs of this pair are done: judge it now
                judged.append(judges.submit(
                    judge_pair_safely, by_id[task_id], i,
                    sessions[(task_id, "with", i)], sessions[(task_id, "without", i)], settings, out,
                ))
        scores = sorted(
            (score for future in judged for score in future.result()),
            key=lambda s: ([t.id for t in tasks].index(s.task), s.index, quality.ARMS.index(s.arm)),
        )

    (out / "results.json").write_text(json.dumps(
        {"model": args.model, "runs": [{**asdict(s), "bad": quality.is_bad(s)} for s in scores]}, indent=2
    ))
    judge_errors = len({(s.task, s.index) for s in scores if s.judge_error})
    print()
    print(quality.format_report(quality.summarize(scores), judge_errors=judge_errors), end="")
    print(f"results: {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
