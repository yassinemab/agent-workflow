#!/usr/bin/env python3
"""Run the workflow's evals: does each prompt reach the right skill, without
editing code first?

Usage: run-evals [--case ID ...] [--model MODEL] [--jobs N] [--repeat N]

Each case runs `claude -p` headless in a throwaway copy of evals/fixture, in
dontAsk permission mode (tools that would need approval are refused, so
nothing outside the copy can change). A run stops as soon as its verdict is
known. Runs use Sonnet by default (`--model opus` to check the model you use
day to day). Each case is a real session on your subscription, so this is
not part of run-checks. Run it after changing a skill
description or a global rule.
"""

from __future__ import annotations

import argparse
import json
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from aw.evals import Case, Observation, Verdict, grade, load_cases, observe  # noqa: E402
from aw.sessions import claude_bin, fixture_copy, run_session  # noqa: E402
from aw.state import state_dir  # noqa: E402

CASES = ROOT / "evals" / "cases.json"
FIXTURE = ROOT / "evals" / "fixture"
RESULTS_DIR = state_dir() / "evals"


@dataclass(frozen=True)
class Settings:
    model: str | None
    max_calls: int
    budget_usd: float
    timeout_s: int


@dataclass(frozen=True)
class Outcome:
    case_id: str
    passed: bool
    reason: str
    tools: list[str]
    cost_usd: float | None
    seconds: float
    final_text: str


def _command(case: Case, settings: Settings) -> list[str]:
    command = [
        claude_bin(), "-p", case.prompt,
        "--output-format", "stream-json", "--verbose",
        "--permission-mode", "dontAsk",
        "--max-budget-usd", str(settings.budget_usd),
        "--no-session-persistence",
    ]
    return command + (["--model", settings.model] if settings.model else [])


def run_case(case: Case, settings: Settings) -> Outcome:
    with tempfile.TemporaryDirectory(prefix=f"aw-eval-{case.id}-") as tmp:
        repo = fixture_copy(FIXTURE, Path(tmp), case.uncommitted)
        end = run_session(
            _command(case, settings), repo, settings.timeout_s, lambda lines: observe(lines, case, settings.max_calls)
        )
    seen: Observation = end.value
    verdict = Verdict(False, f"timed out after {settings.timeout_s}s") if end.timed_out and not seen.calls else grade(seen, case)
    return Outcome(
        case_id=case.id,
        passed=verdict.passed,
        reason=verdict.reason,
        tools=[f"Skill:{c.skill}" if c.skill else c.name for c in seen.calls],
        cost_usd=seen.cost_usd,
        seconds=end.seconds,
        final_text=seen.final_text,
    )


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--case", action="append", default=[], help="run only this case id (repeatable)")
    parser.add_argument("--model", default="sonnet", help="model for the runs (default: sonnet, the cheaper tier)")
    parser.add_argument("--jobs", type=int, default=3, help="cases to run in parallel")
    parser.add_argument("--repeat", type=int, default=1, help="runs per case, to see flakiness")
    parser.add_argument("--max-calls", type=int, default=8, help="tool calls before a case counts as 'no skill'")
    parser.add_argument("--budget", type=float, default=1.0, help="maximum USD per run")
    parser.add_argument("--timeout", type=int, default=300, help="seconds per run")
    args = parser.parse_args(argv[1:])

    cases = load_cases(CASES)
    if args.case:
        unknown = set(args.case) - {c.id for c in cases}
        if unknown:
            print(f"run-evals: unknown case(s): {', '.join(sorted(unknown))}", file=sys.stderr)
            return 2
        cases = [c for c in cases if c.id in args.case]
    settings = Settings(args.model, args.max_calls, args.budget, args.timeout)
    runs = [case for case in cases for _ in range(args.repeat)]

    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        outcomes = list(pool.map(lambda case: run_case(case, settings), runs))

    width = max(len(o.case_id) for o in outcomes)
    for outcome in outcomes:
        cost = f"${outcome.cost_usd:.2f}" if outcome.cost_usd is not None else "  —  "
        print(f"{'PASS' if outcome.passed else 'FAIL'}  {outcome.case_id:<{width}}  {cost}  {outcome.seconds:>5}s  {outcome.reason}")
        if not outcome.passed:
            print(f"      tools: {', '.join(outcome.tools) or '(none)'}")
            if outcome.final_text:
                print(f"      said: {' '.join(outcome.final_text.split())[:300]}")
    passed = sum(o.passed for o in outcomes)
    print(f"\n{passed}/{len(outcomes)} passed")

    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
    report = RESULTS_DIR / f"{time.strftime('%Y%m%d-%H%M%S')}.json"
    report.write_text(json.dumps({"model": args.model, "outcomes": [asdict(o) for o in outcomes]}, indent=2))
    print(f"results: {report}")
    return 0 if passed == len(outcomes) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
